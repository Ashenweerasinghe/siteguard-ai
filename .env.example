GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_CLOUD_PROJECT=siteguard-ai-511715
GCS_BUCKET=siteguard-ai-511715-evidence

# --- Optional -------------------------------------------------------------
# Storage: auto (default: Firestore if Google credentials exist, else local) | firestore | local
# SITEGUARD_BACKEND=auto
# Run the whole workflow without calling Gemini (offline demo / rate-limit fallback)
# SITEGUARD_MOCK_AI=1
# Signs "Remember me" tokens -- set a long random value in production
# SITEGUARD_SECRET=change-me
# Display time zone
# SITEGUARD_TZ=Asia/Colombo
# Users as JSON (alternative to .streamlit/secrets.toml), hashes from scripts/hash_password.py
# SITEGUARD_USERS={"jdoe": {"name": "Jane Doe", "role": "Safety Officer", "password_hash": "pbkdf2$200000$..."}}
